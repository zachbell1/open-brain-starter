# Supabase -- get these from your project's Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# WARNING: The service role key bypasses Row Level Security.
# Never expose it in client-side code, browser environments, or public repos.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# OpenAI -- for embeddings (text-embedding-3-small) and metadata extraction (gpt-4o-mini)
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Access key -- protects your MCP endpoint. Generate with:
#   openssl rand -hex 32
BRAIN_ACCESS_KEY=your-64-char-hex-key-here
